<Window x:Class="PersonalAIAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PersonalAIAssistant.Views"
        Title="ATOM Personal AI Assistant"
        Width="1320"
        Height="860"
        MinWidth="1020"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type views:DashboardView}">
            <views:DashboardView />
        </DataTemplate>
        
        <!-- Pulsing Core Glow Storyboard -->
        <Storyboard x:Key="PulseGlow" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.4" To="1.0" Duration="0:0:1.8" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="18">
            <DockPanel LastChildFill="True">
                <!-- Branding & Core Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource NeonCyanGradient}">
                            <TextBlock Text="⚛" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#040D14" FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ATOM CORE" Style="{StaticResource AppTitleText}" FontSize="17" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentGreenBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="NEURAL MATRIX ONLINE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentGreenBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Button Content="+ NEW CONVERSATION" Command="{Binding NewChatCommand}" Style="{StaticResource PrimaryButton}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Navigation Item List -->
                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="6,2">
                                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- MAIN VIEWPORT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP STATUS & SEARCH BAR -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBox}" MaxWidth="440" HorizontalAlignment="Left" Width="420" />

                    <!-- Model Status Indicator -->
                    <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MODEL: " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentModel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- ARC Automation State Tag -->
                    <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="ARC V1.0 READY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- User Profile Avatar -->
                    <Border Grid.Column="3" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource NeuralPurpleGradient}" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#A855F7" BlurRadius="12" ShadowDepth="0" Opacity="0.4" />
                        </Border.Effect>
                        <TextBlock Text="VP" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="13" />
                    </Border>
                </Grid>
            </Border>

            <!-- ACTIVE PAGE CONTENT -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
