<UserControl x:Class="PersonalAIAssistant.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource SectionTitleText}" />
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Storage" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="{Binding StorageUsage}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="System" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="{Binding SystemStatus}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="{Binding CpuUsage}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RAM" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="{Binding RamUsage}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
            </UniformGrid>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recent Chats" FontWeight="SemiBold" Margin="0,0,0,10" /><ItemsControl ItemsSource="{Binding RecentChats}" /></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Favorite Prompts" FontWeight="SemiBold" Margin="0,0,0,10" /><ItemsControl ItemsSource="{Binding FavoritePrompts}" /></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Installed Models" FontWeight="SemiBold" Margin="0,0,0,10" /><ItemsControl ItemsSource="{Binding InstalledModels}" /></StackPanel></Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
