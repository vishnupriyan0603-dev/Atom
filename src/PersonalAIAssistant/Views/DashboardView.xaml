<UserControl x:Class="PersonalAIAssistant.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28">
        <StackPanel>
            <!-- Dashboard Title with Subtitle -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Autonomous Intelligence Matrix" Style="{StaticResource SectionTitleText}" Margin="0,0,0,4" />
                <TextBlock Text="Real-time multi-agent telemetry, hardware compute load, and system cognition status." Foreground="{DynamicResource MutedTextBrush}" FontSize="13" />
            </StackPanel>

            <!-- Top Row: 4 Metric Cards with Glowing Borders -->
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <!-- Storage Metric -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="KNOWLEDGE VECTORS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding StorageUsage}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,4" />
                        <TextBlock Text="RAG Engine Synced" FontSize="11" Foreground="{DynamicResource DimTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- System Core Metric -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CORE STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding SystemStatus}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentGreenBrush}" Margin="0,6,0,4" />
                        <TextBlock Text="0 Faults &bull; ARC Active" FontSize="11" Foreground="{DynamicResource DimTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- CPU Core Metric -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CPU LOAD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding CpuUsage}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBrush}" Margin="0,6,0,4" />
                        <TextBlock Text="Local Inference Ready" FontSize="11" Foreground="{DynamicResource DimTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- RAM Allocation Metric -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RAM ALLOCATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding RamUsage}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentRoseBrush}" Margin="0,6,0,4" />
                        <TextBlock Text="Dynamic Context Cache" FontSize="11" Foreground="{DynamicResource DimTextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Bottom Row: 3 Feed Cards -->
            <UniformGrid Columns="3" Margin="0,10,0,0">
                <!-- Recent Chats -->
                <Border Style="{StaticResource Card}" MinHeight="300">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="RECENT SESSIONS" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="LIVE" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding RecentChats}" />
                    </StackPanel>
                </Border>

                <!-- Favorite Prompts -->
                <Border Style="{StaticResource Card}" MinHeight="300">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="QUICK PROMPTS" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="PINNED" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBrush}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding FavoritePrompts}" />
                    </StackPanel>
                </Border>

                <!-- Installed Models & Engines -->
                <Border Style="{StaticResource Card}" MinHeight="300">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="NEURAL GATEWAYS" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="6 ACTIVE" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentGreenBrush}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding InstalledModels}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
