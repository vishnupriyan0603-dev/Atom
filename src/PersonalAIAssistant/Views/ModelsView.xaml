<UserControl x:Class="PersonalAIAssistant.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel>
            <TextBlock Text="AI Models" Style="{StaticResource SectionTitleText}" Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="Cloud Models" FontWeight="SemiBold" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding CloudModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Configure" Style="{StaticResource SecondaryButton}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Provider}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Local Models" FontWeight="SemiBold" Margin="0,12,0,10" />
            <ItemsControl ItemsSource="{Binding LocalModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Start" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                    <Button Content="Stop" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                    <Button Content="Delete" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Provider}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding ContextLength, StringFormat=Context: {0}}" Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
