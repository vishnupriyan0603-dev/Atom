<UserControl x:Class="PersonalAIAssistant.Views.PromptLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="Categories" FontWeight="SemiBold" Margin="0,0,0,10" />
            <ListBox ItemsSource="{Binding Categories}" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="22,0,0,0">
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Import" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                    <Button Content="Export" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <TextBlock Text="Prompt Library" Style="{StaticResource SectionTitleText}" Foreground="{DynamicResource TextBrush}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Prompts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,8,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Favorite" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                    <Button Content="Use Prompt" Style="{StaticResource PrimaryButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
