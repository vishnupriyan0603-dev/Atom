<UserControl x:Class="PersonalAIAssistant.Views.SelfImprovementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.leocad.com/wpf/ui"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="ATOM Self-Learning &amp; Safety Control Gate" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Monitor performance flaws, sandbox experiments, and authorize candidate model promotions" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Status & Refresh Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Button Grid.Column="1" Content="Refresh Data" Command="{Binding LoadDataCommand}" Padding="15,6"/>
        </Grid>

        <!-- Main Content Lists -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Pending Safety Approvals Card -->
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="🛡️ Pending Safety Approvals (Human Authorization Gate)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>
                        
                        <ItemsControl ItemsSource="{Binding PendingApprovals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Action}" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding Reason}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='Requested on {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Approve ✅" Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#16A34A" Foreground="White" Margin="0,0,8,0" Padding="12,6"/>
                                                <Button Content="Reject ❌" Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#DC2626" Foreground="White" Padding="12,6"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Sandbox Experiments Card -->
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="🧪 Sandbox Experiments &amp; A/B Benchmarks" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding Experiments}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Height="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Target Component" Binding="{Binding TargetComponent}" Width="150"/>
                                <DataGridTextColumn Header="Baseline Score" Binding="{Binding BaselineScore, StringFormat='{}{0:P1}'}" Width="110"/>
                                <DataGridTextColumn Header="Candidate Score" Binding="{Binding CandidateScore, StringFormat='{}{0:P1}'}" Width="110"/>
                                <DataGridTextColumn Header="Improvement" Binding="{Binding ImprovementPct, StringFormat='+{0:F1}%'}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Flaws & Performance Drops Card -->
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="⚠️ Detected Flaws &amp; Performance Drops" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding Flaws}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Height="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Prompt Version" Binding="{Binding PromptVersion}" Width="120"/>
                                <DataGridTextColumn Header="Model Name" Binding="{Binding ModelName}" Width="*"/>
                                <DataGridTextColumn Header="Avg Accuracy" Binding="{Binding AccuracyScore, StringFormat='{}{0:P1}'}" Width="120"/>
                                <DataGridTextColumn Header="Error Rate" Binding="{Binding ErrorRate, StringFormat='{}{0:P1}'}" Width="120"/>
                                <DataGridTextColumn Header="Evaluations" Binding="{Binding EvaluationCount}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Text="ATOM Safety Gate • Changes require human authorization before production promotion" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
