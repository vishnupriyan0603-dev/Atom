<UserControl x:Class="PersonalAIAssistant.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Chat" Style="{StaticResource SectionTitleText}" Foreground="{DynamicResource TextBrush}" />
        <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" MaxWidth="820" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="{Binding Role}" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Attach" Style="{StaticResource SecondaryButton}" />
                <TextBox Grid.Column="1" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" AcceptsReturn="True" TextWrapping="Wrap" Margin="10,0" />
                <Button Grid.Column="2" Content="Mic" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="Send" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
