<UserControl x:Class="PersonalAIAssistant.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource SectionTitleText}" Foreground="{DynamicResource TextBrush}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock Text="Use the top bar to switch between Light, Dark, and Auto Windows theme. The choice is saved locally." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="AI Provider Keys" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ProviderSettings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Configure" Style="{StaticResource SecondaryButton}" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
