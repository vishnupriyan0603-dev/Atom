<!DOCTYPE html>
<html>
<head>
  <title>Atom AI Assistant</title>
  <hta:application
    id="AtomDesktopApp"
    applicationname="Atom"
    border="thin"
    borderstyle="normal"
    caption="yes"
    maximizebutton="yes"
    minimizebutton="yes"
    scroll="no"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    windowstate="normal"
  />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <link rel="stylesheet" href="assets/atom.css" />
</head>
<body>
  <div class="app">
    <div class="sidebar">
      <div class="sidebar-top">
        <div class="brand">
          <div class="brand-box">A</div>
          <span class="brand-name">Atom</span>
        </div>
        <div class="status-bar">
          <span class="status-dot"></span>
          <span id="statusText">System Online</span>
        </div>
      </div>

      <div class="sidebar-nav">
        <div class="nav-item active" data-tab="assistant"><span class="nav-icon">&#9679;</span> Assistant</div>
        <div class="nav-item" data-tab="automation"><span class="nav-icon">&#9881;</span> Automation</div>
        <div class="nav-item" data-tab="knowledge"><span class="nav-icon">&#128214;</span> Knowledge <span class="nav-badge">3</span></div>
        <div class="nav-item" data-tab="settings"><span class="nav-icon">&#9878;</span> Settings</div>
      </div>

      <div class="sidebar-footer"></div>
    </div>

    <div class="main">
      <div class="main-top">
        <div class="main-head">
          <h1>AI Assistant</h1>
          <p>Atom AI Assistant - connected to backend API for chat, models, and knowledge features.</p>
        </div>
        <div class="main-actions">
          <span class="badge badge-green" id="statusBadge">&#9679; Connected</span>
        </div>
      </div>

      <div class="workspace">
        <div class="col-console">
          <div class="card">
            <div class="card-head"><span class="dot"></span> Assistant Console</div>
            <div class="card-body">
              <div id="msgBox" class="msg-box">
                <div class="welcome">Welcome to Atom AI Assistant. Type a message below to get started.</div>
              </div>
              <div id="typingIndicator" class="typing" style="display:none">
                <span>Atom is typing</span>
                <span class="typing-dots"><span></span><span></span><span></span></span>
              </div>
              <div class="input-row">
                <input id="msgInput" type="text" placeholder="Type a message for the assistant..." onkeydown="if(event.key==='Enter')sendMsg()" />
                <button class="btn btn-p" onclick="sendMsg()">Send</button>
              </div>
              <div class="quick-bar">
                <button class="btn btn-s" onclick="quickAct('help')">Help</button>
                <button class="btn btn-s" onclick="quickAct('status')">Status</button>
                <button class="btn btn-s" onclick="quickAct('clear')">Clear</button>
              </div>
              <div class="card-foot">
                <span class="ft">Atom v1.0 &mdash; Desktop Shell</span>
                <button class="btn-ghost" onclick="clearChat()">Clear Chat</button>
              </div>
            </div>
          </div>
        </div>

        <div class="col-bot">
          <div class="bot-card">
            <div class="bot-stage">
              <div class="bot-fig">
                <div class="b-ant"></div><div class="b-ant-dot"></div>
                <div class="b-head"><div class="b-eye l"></div><div class="b-eye r"></div><div class="b-mouth"></div></div>
                <div class="b-arm l"></div><div class="b-arm r"></div>
                <div class="b-body"><div class="b-core"><div class="b-core-dot"></div></div></div>
                <div class="b-base"></div>
              </div>
            </div>
            <div class="bot-info">
              <div class="bot-info-row">
                <span class="bot-name">Atom Bot</span>
                <span class="bot-tag">Online</span>
              </div>
              <div class="bot-desc">Built-in desktop avatar. Pure CSS. No external files needed.</div>
              <div class="bot-stats">
                <div class="bot-stat"><div class="bot-stat-val" id="msgCount">0</div><div class="bot-stat-lbl">Messages</div></div>
                <div class="bot-stat"><div class="bot-stat-val" id="sessions">1</div><div class="bot-stat-lbl">Session</div></div>
                <div class="bot-stat"><div class="bot-stat-val" id="uptime">0m</div><div class="bot-stat-lbl">Uptime</div></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div id="toast" class="toast"></div>
  <script src="assets/atom.js"></script>
</body>
</html>
