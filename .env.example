# ATOM Environment Configuration

# Provider: groq, gemini, openai, or local (Ollama/LM Studio via OpenAI-compatible endpoint)
LLM_PROVIDER=groq

# Model name
#   Groq:     openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile
#   Gemini:   gemini-3.6-flash (recommended), gemini-3.5-flash, gemini-flash-latest
#   OpenAI:   gpt-4o-mini, gpt-4o, gpt-3.5-turbo
#   Local:    llama3.1, deepseek-coder, qwen2.5-coder (Ollama models)
LLM_MODEL=openai/gpt-oss-120b

# API credential key (leave empty for local Ollama/LM Studio)
LLM_API_KEY=your-groq-or-openai-key

# API Endpoint URL
#   Groq:     https://api.groq.com/openai/v1
#   Gemini:   https://generativelanguage.googleapis.com/v1beta
#   OpenAI:   https://api.openai.com/v1
#   Local:    http://localhost:11434/v1  (Ollama) or http://localhost:1234/v1 (LM Studio)
LLM_API_URL=https://api.groq.com/openai/v1

# Provider-specific overrides (optional; used when LLM_PROVIDER matches)
# GROQ_API_KEY=
# GROQ_API_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Generation controls (optional)
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Local fallback model (Ollama) used when the primary provider fails
LLM_LOCAL_ENDPOINT=http://localhost:11434/v1
LLM_LOCAL_MODEL=llama3.1

# JWT authentication secret (backend) - set a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY=2592000
