<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ATOM - Personal AI Operating Environment</title>
  <link rel="stylesheet" href="css/style.css">
  <style>
    /* Premium modern styling additions to style.css */
    .app-layout {
      display: flex;
      width: 100%;
      height: 100vh;
      background: var(--bg-app);
      overflow: hidden;
    }
    .main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      height: 100%;
      overflow-y: auto;
      padding: 30px;
    }
    .sidebar-collapsed {
      width: 70px !important;
      min-width: 70px !important;
    }
    .sidebar-collapsed .brand-name,
    .sidebar-collapsed .user-details,
    .sidebar-collapsed .nav-text {
      display: none !important;
    }
    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-top: 24px;
    }
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      transition: all 0.2s ease;
    }
    .card:hover {
      border-color: var(--green);
    }
    .card-title {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
      margin-bottom: 8px;
    }
    .card-value {
      font-size: 28px;
      font-weight: 800;
      color: var(--text-primary);
    }
    .page-section {
      display: none;
    }
    .page-section.active {
      display: block;
    }
    .progress-bar-container {
      background: var(--border-light);
      border-radius: 6px;
      height: 10px;
      overflow: hidden;
      margin-top: 8px;
    }
    .progress-bar-fill {
      background: var(--green);
      height: 100%;
      width: 0%;
      transition: width 0.3s ease;
    }
    .collab-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      background: rgba(59, 130, 246, 0.15);
      color: var(--blue);
      border: 1px solid rgba(59, 130, 246, 0.3);
    }
    .timeline {
      border-left: 2px solid var(--border);
      padding-left: 20px;
      margin-left: 10px;
      margin-top: 20px;
    }
    .timeline-item {
      position: relative;
      margin-bottom: 24px;
    }
    .timeline-item::before {
      content: '';
      position: absolute;
      left: -27px;
      top: 4px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--green);
    }
    .timeline-time {
      font-size: 11px;
      color: var(--text-muted);
    }
    .timeline-desc {
      font-size: 13px;
      color: var(--text-secondary);
      margin-top: 4px;
    }
    .code-list-item {
      display: flex;
      justify-content: space-between;
      padding: 12px;
      border-bottom: 1px solid var(--border-light);
      font-family: monospace;
      font-size: 12px;
    }
    .toggle-sidebar-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 18px;
      padding: 10px;
    }
  </style>
</head>
<body>
  <div class="app-layout">
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-top">
        <div class="brand">
          <div class="brand-box">A</div>
          <span class="brand-name">ATOM</span>
          <button class="toggle-sidebar-btn" onclick="toggleSidebar()">☰</button>
        </div>
        <div class="status-bar">
          <span class="status-dot" id="statusDot"></span>
          <span id="statusText" class="brand-name">Connecting...</span>
        </div>
      </div>

      <div class="model-selector">
        <label for="modelSelect">AI Model</label>
        <select id="modelSelect" onchange="onModelChange()">
          <option value="gemini-3.6-flash">Gemini 3.6 Flash</option>
          <option value="llama3.1">Ollama llama3.1</option>
        </select>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-item active" onclick="switchPage('dashboard')">
          <span class="nav-icon">⌂</span> <span class="nav-text">Dashboard</span>
        </div>
        <div class="nav-item" onclick="switchPage('chat')">
          <span class="nav-icon">✉</span> <span class="nav-text">Chat</span>
        </div>
        <div class="nav-item" onclick="switchPage('memory')">
          <span class="nav-icon">⚓</span> <span class="nav-text">Memory</span>
        </div>
        <div class="nav-item" onclick="switchPage('knowledge')">
          <span class="nav-icon">📚</span> <span class="nav-text">Knowledge</span>
        </div>
        <div class="nav-item" onclick="switchPage('learning')">
          <span class="nav-icon">🎚</span> <span class="nav-text">Learning</span>
        </div>
        <div class="nav-item" onclick="switchPage('workspace')">
          <span class="nav-icon">📁</span> <span class="nav-text">Workspace</span>
        </div>
        <div class="nav-item" onclick="switchPage('collaboration')">
          <span class="nav-icon">🤝</span> <span class="nav-text">Collaboration</span>
        </div>
        <div class="nav-item" onclick="openSettingsModal()">
          <span class="nav-icon">⚙</span> <span class="nav-text">Settings</span>
        </div>
      </nav>

      <div class="sidebar-user" onclick="openSettingsModal()">
        <div class="user-info">
          <div class="user-avatar" id="sidebarAvatar">V</div>
          <div class="user-details">
            <span class="user-name" id="sidebarName">Vichu</span>
            <span class="user-role">Developer</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Workspace -->
    <div class="main-content">
      
      <!-- Section 1: Dashboard -->
      <section id="page-dashboard" class="page-section active">
        <h2>Good evening, Vichu.</h2>
        <p style="color: var(--text-muted)">ATOM is ready to assist you.</p>

        <div class="dashboard-grid">
          <div class="card">
            <div class="card-title">Atom Status</div>
            <div class="card-value" style="color: var(--green)">ONLINE</div>
          </div>
          <div class="card">
            <div class="card-title">AI Provider</div>
            <div class="card-value" id="dashProvider">GEMINI</div>
          </div>
          <div class="card">
            <div class="card-title">Learning Level</div>
            <div class="card-value" id="dashLearningLevel">LEVEL 3</div>
          </div>
          <div class="card">
            <div class="card-title">Safe Mode</div>
            <div class="card-value">ENABLED</div>
          </div>
        </div>

        <div class="dashboard-grid" style="margin-top: 20px;">
          <div class="card">
            <div class="card-title">Workspace Files</div>
            <div class="card-value" id="dashWorkspaceFiles">595</div>
          </div>
          <div class="card">
            <div class="card-title">PDF Documents</div>
            <div class="card-value" id="dashPdfCount">1</div>
          </div>
          <div class="card">
            <div class="card-title">Memories</div>
            <div class="card-value" id="dashMemoriesCount">0</div>
          </div>
        </div>
      </section>

      <!-- Section 2: Chat -->
      <section id="page-chat" class="page-section">
        <div style="display: flex; gap: 20px; height: calc(100vh - 120px);">
          <div style="width: 240px; display: flex; flex-direction: column; border-right: 1px solid var(--border); padding-right: 20px;">
            <h3>Conversations</h3>
            <button class="btn btn-p" onclick="newChat()" style="margin: 10px 0;">+ New Chat</button>
            <div class="chat-list" id="chatList" style="flex: 1; overflow-y: auto;"></div>
          </div>
          
          <div style="flex: 1; display: flex; flex-direction: column; height: 100%;">
            <div class="main-top">
              <h2 id="chatTitle">General Chat</h2>
              <div class="collab-badge" id="collabIndicator">ATOM</div>
            </div>
            
            <div class="messages" id="messages" style="flex: 1; overflow-y: auto; margin-bottom: 20px; padding-right: 10px;">
              <div class="welcome" id="welcome">
                <div class="welcome-icon">A</div>
                <h2>Welcome to ATOM</h2>
                <p id="welcomeStatus">Ask a question or request workspace modifications.</p>
              </div>
            </div>

            <div id="typingIndicator" class="typing" style="display:none; margin-bottom: 10px;">
              <span class="typing-dots"><span></span><span></span><span></span></span>
              <span>Atom is analyzing context...</span>
            </div>

            <div class="input-area">
              <div class="input-row">
                <textarea id="msgInput" rows="1" placeholder="Ask Atom..." onkeydown="handleKey(event)"></textarea>
                <button class="btn btn-p" onclick="sendMsg()">Send</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Memory -->
      <section id="page-memory" class="page-section">
        <h2>Atom Stored Memory</h2>
        <p style="color: var(--text-muted)">Long-term preference tracking & developer profile memories.</p>

        <div style="margin-top: 20px;">
          <input type="text" id="memorySearch" placeholder="Search memories..." oninput="filterMemories()" style="width: 100%; height: 40px; padding: 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-input); color: var(--text-primary); margin-bottom: 20px;">
          <div id="memoriesGrid" class="dashboard-grid">
            <!-- Dynamic memories cards -->
          </div>
        </div>
      </section>

      <!-- Section 4: Knowledge Library -->
      <section id="page-knowledge" class="page-section">
        <h2>Knowledge Library</h2>
        <p style="color: var(--text-muted)">Upload documentation and guides for RAG search context.</p>

        <div style="margin-top: 20px; background: var(--bg-card); padding: 30px; border-radius: 12px; border: 1px dashed var(--border); text-align: center;">
          <div class="welcome-icon" style="margin: 0 auto 10px;">↑</div>
          <h3>Upload Documentation PDF</h3>
          <p style="color: var(--text-muted); font-size: 12px; margin-bottom: 15px;">Drag & drop your files here or select file manually.</p>
          <input type="file" id="pdfUploadInput" accept="application/pdf" style="display: none;" onchange="uploadPdf()">
          <button class="btn btn-p" onclick="document.getElementById('pdfUploadInput').click()">Select PDF</button>
        </div>

        <div style="margin-top: 30px;">
          <h3>Ingested Documents</h3>
          <div id="pdfLibraryGrid" class="dashboard-grid" style="margin-top: 15px;">
            <!-- Dynamic PDF list -->
          </div>
        </div>
      </section>

      <!-- Section 5: Learning -->
      <section id="page-learning" class="page-section">
        <h2>Learning Center</h2>
        <p style="color: var(--text-muted)">Track topic confidence level metrics computed from workspace source usage.</p>

        <div class="dashboard-grid" style="margin-top: 24px;">
          <div class="card" style="grid-column: span 2;">
            <div class="card-title">Overall Knowledge Level</div>
            <div class="card-value" id="overallLevelText">LEVEL 1 - BEGINNER</div>
            <div class="progress-bar-container">
              <div class="progress-bar-fill" id="overallLevelBar" style="width: 20%;"></div>
            </div>
          </div>
          <div class="card">
            <button class="btn btn-p" onclick="switchLearningSub('gaps')" style="width: 100%; margin-bottom: 10px;">View Gaps</button>
            <button class="btn btn-s" onclick="switchLearningSub('history')" style="width: 100%;">View History</button>
          </div>
        </div>

        <div style="margin-top: 30px;" id="learningSubContent">
          <h3>Active Development Topics</h3>
          <div class="dashboard-grid" id="learningTopicsGrid" style="margin-top: 15px;">
            <!-- Dynamic Topics -->
          </div>
        </div>
      </section>

      <!-- Section 6: Workspace -->
      <section id="page-workspace" class="page-section">
        <h2>Workspace Explorer</h2>
        <p style="color: var(--text-muted)">Project structure and file indexing stats.</p>

        <div style="margin-top: 20px;">
          <input type="text" id="workspaceSearch" placeholder="Search workspace files..." oninput="filterWorkspace()" style="width: 100%; height: 40px; padding: 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-input); color: var(--text-primary); margin-bottom: 20px;">
          <div id="workspaceFilesList" style="background: var(--bg-card); border-radius: 8px; border: 1px solid var(--border); max-height: 400px; overflow-y: auto;">
            <!-- Dynamic file rows -->
          </div>
        </div>
      </section>

      <!-- Section 7: Collaboration -->
      <section id="page-collaboration" class="page-section">
        <h2>Gemini Collaboration</h2>
        <p style="color: var(--text-muted)">Manage the collaboration mode between local routing & cloud reasoning.</p>

        <div class="card" style="margin-top: 24px; max-width: 600px;">
          <h3>Collaboration Mode</h3>
          <p style="color: var(--text-muted); font-size: 12px; margin-bottom: 15px;">Configure whether ATOM handles tasks locally or queries Gemini collaborator.</p>
          
          <select id="collabModeSelect" onchange="updateCollabMode()" style="width: 100%; height: 40px; padding: 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-input); color: var(--text-primary); margin-bottom: 20px;">
            <option value="local">LOCAL (Only local knowledge)</option>
            <option value="balanced">BALANCED (Queries Gemini for teaching/gaps)</option>
            <option value="collaborative">COLLABORATIVE (Full Gemini reasoning/validation)</option>
          </select>

          <div style="border-top: 1px solid var(--border); padding-top: 15px;">
            <h4>Collaborative Roles Enabled:</h4>
            <ul style="list-style: none; margin-top: 10px; color: var(--text-secondary); line-height: 2;">
              <li>✓ TEACHER (Gemini explains new paradigms)</li>
              <li>✓ VALIDATOR (Gemini verifies code consistency)</li>
              <li>✓ EXPLAINER (Gemini summarizes technical reference chapters)</li>
            </ul>
          </div>
        </div>
      </section>

    </div>
  </div>

  <!-- Settings Modal (From original) -->
  <div class="modal-overlay" id="settingsModal">
    <div class="modal-card">
      <div class="modal-header">
        <h2>ATOM Settings & Privacy Control</h2>
        <button class="btn btn-s" onclick="closeSettingsModal()">Close</button>
      </div>
      <div class="settings-tabs">
        <div class="settings-tab active" id="tabbtn-profile" onclick="switchTab('profile')">Profile</div>
        <div class="settings-tab" id="tabbtn-biometrics" onclick="switchTab('biometrics')">Biometrics</div>
        <div class="settings-tab" id="tabbtn-privacy" onclick="switchTab('privacy')">Personal Data</div>
      </div>
      <div class="modal-body">
        
        <!-- Tab 1: Profile -->
        <div class="tab-content active" id="tab-profile">
          <form id="editProfileForm" onsubmit="saveProfile(event)">
            <div class="image-upload-wrapper">
              <div class="image-preview" id="editAvatarPreview">V</div>
              <div>
                <label class="btn-upload" for="editAvatarInput">Change Photo</label>
                <input type="file" id="editAvatarInput" accept="image/*" style="display:none" onchange="previewImage(this, 'editAvatarPreview')">
                <button type="button" class="btn btn-s" style="margin-left: 8px" onclick="removeAvatar()">Remove</button>
              </div>
            </div>
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" id="editFullName" required>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Preferred Name</label>
                <input type="text" id="editPrefName">
              </div>
              <div class="form-group">
                <label>ATOM Display Name</label>
                <input type="text" id="editDisplayName">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Preferred Language</label>
                <input type="text" id="editLanguage">
              </div>
              <div class="form-group">
                <label>Timezone</label>
                <input type="text" id="editTimezone">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Response Style</label>
                <select id="editStyle">
                  <option value="concise">Concise</option>
                  <option value="detailed">Detailed</option>
                  <option value="creative">Creative</option>
                </select>
              </div>
              <div class="form-group">
                <label>Explanation Level</label>
                <select id="editLevel">
                  <option value="beginner">Beginner</option>
                  <option value="intermediate">Intermediate</option>
                  <option value="expert">Advanced/Expert</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label>Technologies</label>
              <input type="text" id="editTechs">
            </div>
            <div class="form-group">
              <label>Use Cases</label>
              <textarea id="editUseCases" rows="2"></textarea>
            </div>
            <button type="submit" class="btn btn-p" style="width: 100%">Save Profile</button>
          </form>
        </div>

        <!-- Tab 2: Biometrics -->
        <div class="tab-content" id="tab-biometrics">
          <div class="form-group">
            <label style="display:flex; align-items:center; gap: 8px;">
              <input type="checkbox" id="bioEnabledCheckbox" onchange="toggleBioPhotoField()"> Enable Local Face Biometrics
            </label>
            <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Opt-in local-only biometric capabilities. Face data is strictly isolated locally and never sent to external AI reasoning providers.</p>
          </div>
          <div class="form-group" id="bioPhotoUploadGroup" style="display: none;">
            <label>Upload Face Photo (Optional)</label>
            <div class="image-upload-wrapper">
              <div class="image-preview" id="bioPhotoPreview" style="border-radius: 8px;">No Photo</div>
              <div>
                <label class="btn-upload" for="bioPhotoInput">Upload Photo</label>
                <input type="file" id="bioPhotoInput" accept="image/*" style="display:none" onchange="previewImage(this, 'bioPhotoPreview')">
              </div>
            </div>
          </div>
          <button type="button" class="btn btn-p" style="width: 100%" onclick="saveBiometrics()">Save Biometric Settings</button>
        </div>

        <!-- Tab 3: Privacy & Data Control -->
        <div class="tab-content" id="tab-privacy">
          <div class="form-group" style="margin-bottom: 24px;">
            <label>View and Export Data</label>
            <p style="font-size: 11px; color: var(--text-muted); margin-bottom: 8px;">Export your complete conversation logs, memories, profile, and study data as a portable JSON file.</p>
            <button type="button" class="btn btn-s" onclick="exportData()">Export My ATOM Data</button>
          </div>
          <div class="danger-section">
            <h3>Danger Zone (Wipe Controls)</h3>
            <p style="font-size: 11px; color: var(--text-muted); margin-bottom: 12px;">Delete specific blocks of local data. These actions are irreversible.</p>
            <div class="danger-actions">
              <button type="button" class="btn-danger" onclick="wipeData('conversations')">Wipe Chat Logs</button>
              <button type="button" class="btn-danger" onclick="wipeData('memories')">Wipe Memories</button>
              <button type="button" class="btn-danger" onclick="wipeData('training')">Wipe Training Logs</button>
              <button type="button" class="btn-danger" onclick="wipeData('knowledge')">Wipe Books Index</button>
              <button type="button" class="btn-danger" onclick="wipeData('face')">Wipe Biometrics</button>
              <button type="button" class="btn-danger" onclick="wipeData('reset')">Reset Personalization</button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Onboarding modal (placeholder structure to satisfy setup initialization check) -->
  <div class="modal-overlay" id="setupModal">
    <div class="modal-card">
      <div class="modal-header">
        <h2>Launch ATOM Environment</h2>
      </div>
      <div class="modal-body">
        <p>Your personal AI environment is ready to index database and start active collaboration.</p>
      </div>
      <div class="modal-footer">
        <button class="btn btn-p" onclick="document.getElementById('setupModal').classList.remove('show')">Launch</button>
      </div>
    </div>
  </div>

  <div id="toast" class="toast"></div>
  <script src="js/chat.js"></script>
</body>
</html>
