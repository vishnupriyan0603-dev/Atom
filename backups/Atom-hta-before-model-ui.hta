<!DOCTYPE html>
<html>
<head>
  <title>Atom</title>
  <hta:application
    id="AtomDesktopApp"
    applicationname="Atom"
    border="thin"
    borderstyle="normal"
    caption="yes"
    maximizebutton="yes"
    minimizebutton="yes"
    scroll="no"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    windowstate="normal"
  />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <style>
    html,
    body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      font-family: "Segoe UI", Arial, sans-serif;
      background: #101214;
      color: #f4f6f8;
    }

    .app {
      display: table;
      width: 100%;
      height: 100%;
      background: #101214;
    }

    .sidebar {
      display: table-cell;
      width: 248px;
      padding: 24px;
      vertical-align: top;
      background: #171a1f;
      border-right: 1px solid #2b3138;
    }

    .main {
      display: table-cell;
      padding: 28px;
      vertical-align: top;
    }

    .brand {
      font-size: 28px;
      font-weight: 700;
      letter-spacing: 0;
      margin-bottom: 8px;
    }

    .status {
      display: inline-block;
      padding: 6px 10px;
      margin: 8px 0 24px;
      border: 1px solid #34404c;
      border-radius: 6px;
      color: #9fe3c2;
      background: #14251d;
      font-size: 12px;
      font-weight: 600;
    }

    .nav-item {
      padding: 12px 10px;
      margin-bottom: 6px;
      border-radius: 6px;
      color: #cbd3dc;
      background: #20252b;
      font-size: 14px;
    }

    .nav-item.active {
      color: #ffffff;
      background: #2f6f86;
    }

    h1 {
      margin: 0 0 10px;
      font-size: 34px;
      font-weight: 700;
      letter-spacing: 0;
    }

    .subtitle {
      max-width: 720px;
      margin: 0 0 28px;
      color: #b9c2cc;
      font-size: 15px;
      line-height: 1.5;
    }

    .panel {
      max-width: 860px;
      border: 1px solid #2b3138;
      border-radius: 8px;
      background: #171a1f;
    }

    .panel-header {
      padding: 16px 18px;
      border-bottom: 1px solid #2b3138;
      font-size: 15px;
      font-weight: 650;
    }

    .panel-body {
      padding: 18px;
    }

    .message-area {
      height: 220px;
      padding: 14px;
      overflow: auto;
      border: 1px solid #303741;
      border-radius: 6px;
      background: #0f1114;
      color: #d9e0e7;
      line-height: 1.5;
      font-size: 14px;
    }

    .input-row {
      display: table;
      width: 100%;
      margin-top: 14px;
    }

    .input-cell {
      display: table-cell;
      width: 100%;
      padding-right: 10px;
    }

    .button-cell {
      display: table-cell;
      width: 104px;
    }

    input {
      box-sizing: border-box;
      width: 100%;
      height: 42px;
      padding: 0 12px;
      border: 1px solid #39424e;
      border-radius: 6px;
      outline: none;
      background: #101214;
      color: #f4f6f8;
      font-size: 14px;
    }

    button {
      width: 104px;
      height: 42px;
      border: 0;
      border-radius: 6px;
      color: #ffffff;
      background: #2f6f86;
      font-size: 14px;
      font-weight: 650;
      cursor: pointer;
    }

    .asset-note {
      margin-top: 18px;
      color: #8f9aa6;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="app">
    <div class="sidebar">
      <div class="brand">Atom</div>
      <div class="status">Desktop shell ready</div>
      <div class="nav-item active">Assistant</div>
      <div class="nav-item">Automation</div>
      <div class="nav-item">Knowledge</div>
      <div class="nav-item">Settings</div>
    </div>

    <div class="main">
      <h1>Atom AI Assistant</h1>
      <p class="subtitle">
        Desktop app shell for the Atom personal assistant. This window is ready for future AI, automation, and knowledge features.
      </p>

      <div class="panel">
        <div class="panel-header">Assistant Console</div>
        <div class="panel-body">
          <div id="messages" class="message-area">
            Atom is running as a desktop window. AI chat is not connected yet.
          </div>
          <div class="input-row">
            <div class="input-cell">
              <input id="messageInput" type="text" placeholder="Type a message for the future assistant..." />
            </div>
            <div class="button-cell">
              <button onclick="sendMessage()">Send</button>
            </div>
          </div>
          <div class="asset-note">
            3D model asset: assets/models/atom-bot/source/Atom.blend
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="text/javascript">
    function sendMessage() {
      var input = document.getElementById("messageInput");
      var messages = document.getElementById("messages");
      var text = input.value.replace(/^\s+|\s+$/g, "");

      if (!text) {
        return;
      }

      messages.innerHTML += "<br><br><strong>You:</strong> " + escapeHtml(text);
      messages.innerHTML += "<br><strong>Atom:</strong> Assistant logic is not connected yet.";
      input.value = "";
      messages.scrollTop = messages.scrollHeight;
    }

    function escapeHtml(value) {
      return value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
</body>
</html>

