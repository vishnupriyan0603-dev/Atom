{
  "Theme": {
    "Mode": "System"
  },
  "AI": {
    "Provider": "OpenAI",
    "OpenAI": {
      "Endpoint": "https://api.openai.com/v1",
      "Model": "gpt-4o",
      "MaxTokens": 4096,
      "Temperature": 0.7
    },
    "Azure": {
      "Endpoint": "",
      "DeploymentName": "",
      "ApiKey": ""
    },
    "Anthropic": {
      "Endpoint": "https://api.anthropic.com/v1",
      "Model": "claude-3-opus-20240229"
    },
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "llama3"
    }
  },
  "Backend": {
    "Url": "http://localhost:8080",
    "Token": "",
    "Email": ""
  },
  "Database": {
    "ConnectionString": "Data Source=Data/atomassistant.db"
  },
  "Logging": {
    "MinimumLevel": "Information",
    "Serilog": {
      "WriteTo": [
        { "Name": "File", "Args": { "path": "Logs/atomassistant-.log", "rollingInterval": "Day" } },
        { "Name": "Console" }
      ]
    }
  }
}
