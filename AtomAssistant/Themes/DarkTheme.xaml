<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Colors -->
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.WindowBackgroundBrush}"
                     Color="#1A1A2E" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.PageBackgroundBrush}"
                     Color="#16162A" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.CardBackgroundBrush}"
                     Color="#1E1E3A" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.SidebarBackgroundBrush}"
                     Color="#141428" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.TopBarBackgroundBrush}"
                     Color="#1A1A2E" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.InputBackgroundBrush}"
                     Color="#242442" />

    <!-- Text Colors -->
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.PrimaryTextBrush}"
                     Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.SecondaryTextBrush}"
                     Color="#E0E0F0" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.DisabledTextBrush}"
                     Color="#9090A8" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.InverseTextBrush}"
                     Color="#1A1A2E" />

    <!-- Wpf.Ui Text Overrides (lighter for dark theme) -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"
                     Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"
                     Color="#E0E0F0" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"
                     Color="#C0C0D8" />

    <!-- Border Colors -->
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.SubtleBorderBrush}"
                     Color="#2A2A48" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.CardBorderBrush}"
                     Color="#2E2E4C" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.InputBorderBrush}"
                     Color="#3A3A58" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.FocusBorderBrush}"
                     Color="#22C55E" />

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.PrimaryAccentBrush}"
                     Color="#22C55E" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.PrimaryAccentHoverBrush}"
                     Color="#1DA854" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.PrimaryAccentPressedBrush}"
                     Color="#18904A" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.SuccessAccentBrush}"
                     Color="#22C55E" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.WarningAccentBrush}"
                     Color="#F59E0B" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.ErrorAccentBrush}"
                     Color="#EF4444" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.InfoAccentBrush}"
                     Color="#3B82F6" />

    <!-- Hover / Pressed / Selected -->
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.HoverBackgroundBrush}"
                     Color="#2A2A48" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.PressedBackgroundBrush}"
                     Color="#3A3A58" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.SelectedBackgroundBrush}"
                     Color="#1A3A2E" />
    <SolidColorBrush x:Key="{x:Static Theme:ThemeKeys.SelectedTextBrush}"
                     Color="#22C55E" />

    <!-- Shadow -->
    <DropShadowEffect x:Key="{x:Static Theme:ThemeKeys.CardShadowEffect}"
                      BlurRadius="12" Opacity="0.3"
                      ShadowDepth="4" Color="#000000" />
    <DropShadowEffect x:Key="{x:Static Theme:ThemeKeys.PopupShadowEffect}"
                      BlurRadius="24" Opacity="0.5"
                      ShadowDepth="8" Color="#000000" />

    <!-- Corner Radius -->
    <CornerRadius x:Key="{x:Static Theme:ThemeKeys.CardCornerRadius}">12</CornerRadius>
    <CornerRadius x:Key="{x:Static Theme:ThemeKeys.ButtonCornerRadius}">8</CornerRadius>
    <CornerRadius x:Key="{x:Static Theme:ThemeKeys.InputCornerRadius}">8</CornerRadius>
    <CornerRadius x:Key="{x:Static Theme:ThemeKeys.BadgeCornerRadius}">4</CornerRadius>

    <!-- Card Style -->
    <Style x:Key="{x:Static Theme:ThemeKeys.CardStyle}" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource {x:Static Theme:ThemeKeys.CardBackgroundBrush}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource {x:Static Theme:ThemeKeys.CardBorderBrush}}" />
        <Setter Property="CornerRadius" Value="{StaticResource {x:Static Theme:ThemeKeys.CardCornerRadius}}" />
        <Setter Property="Effect" Value="{StaticResource {x:Static Theme:ThemeKeys.CardShadowEffect}}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Section Header Style -->
    <Style x:Key="{x:Static Theme:ThemeKeys.SectionHeaderStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource {x:Static Theme:ThemeKeys.PrimaryTextBrush}}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Body Text Style -->
    <Style x:Key="{x:Static Theme:ThemeKeys.BodyTextStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource {x:Static Theme:ThemeKeys.SecondaryTextBrush}}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Subtle Divider -->
    <Style x:Key="{x:Static Theme:ThemeKeys.DividerStyle}" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{StaticResource {x:Static Theme:ThemeKeys.SubtleBorderBrush}}" />
        <Setter Property="Margin" Value="0,8" />
    </Style>
</ResourceDictionary>