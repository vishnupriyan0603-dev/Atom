<UserControl x:Class="AtomAssistant.Controls.ChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource ControlElevationBorderBrush}"
                Padding="12,8"
                CornerRadius="8,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="ModelDisplayText"
                           Text="GPT-4o"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      x:Name="ChatScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      Padding="12">
            <StackPanel x:Name="MessagesPanel">
                <ui:ProgressRing x:Name="TypingIndicator"
                                 Visibility="Collapsed"
                                 Width="24"
                                 Height="24"
                                 Margin="0,8"
                                 HorizontalAlignment="Left"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource ControlElevationBorderBrush}"
                Padding="12,8"
                CornerRadius="0,0,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           x:Name="AttachFileButton"
                           Appearance="Transparent"
                           ToolTip="Attach File"
                           Margin="0,0,4,0"
                           Width="32" Height="32">
                    <ui:SymbolIcon Symbol="Attach24" />
                </ui:Button>

                <ui:Button Grid.Column="1"
                           x:Name="ImageButton"
                           Appearance="Transparent"
                           ToolTip="Add Image"
                           Margin="0,0,4,0"
                           Width="32" Height="32">
                    <ui:SymbolIcon Symbol="Image24" />
                </ui:Button>

                <ui:TextBox Grid.Column="2"
                            x:Name="MessageTextBox"
                            PlaceholderText="Type a message..."
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MaxHeight="120"
                            VerticalAlignment="Stretch"
                            Margin="0,0,8,0" />

                <ui:Button Grid.Column="3"
                           x:Name="SendButton"
                           Appearance="Primary"
                           ToolTip="Send"
                           Width="32" Height="32"
                           Margin="0,0,4,0">
                    <ui:SymbolIcon Symbol="Send24" />
                </ui:Button>

                <ui:Button Grid.Column="4"
                           x:Name="StopButton"
                           Appearance="Danger"
                           ToolTip="Stop Generating"
                           Visibility="Collapsed"
                           Width="32" Height="32"
                           Margin="0,0,4,0">
                    <ui:SymbolIcon Symbol="Stop24" />
                </ui:Button>

                <ui:Button Grid.Column="5"
                           x:Name="MicrophoneButton"
                           Appearance="Transparent"
                           ToolTip="Voice Input"
                           Width="32" Height="32">
                    <ui:SymbolIcon Symbol="Microphone24" />
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
