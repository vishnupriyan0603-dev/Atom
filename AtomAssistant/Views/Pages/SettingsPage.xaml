<ui:UiPage x:Class="AtomAssistant.Views.Pages.SettingsPage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
            xmlns:local="clr-namespace:AtomAssistant.Views.Pages"
            mc:Ignorable="d"
            d:DesignHeight="800" d:DesignWidth="1200"
            Title="Settings">

    <ScrollViewer>
        <StackPanel Margin="32" Spacing="24" MaxWidth="800">

            <TextBlock Text="Settings"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <ui:Card Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Theme:" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Language:" VerticalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Backend Connection"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Server URL:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="http://localhost:8080"
                                 Margin="0,0,8,4" />
                        <ui:Button Grid.Row="0" Grid.Column="2"
                                   Appearance="Subtle"
                                   Icon="Connect24"
                                   ToolTip="Test Connection"
                                   Command="{Binding TestBackendConnectionCommand}"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Email:" VerticalAlignment="Center"
                                   Margin="0,8,0,4" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding BackendEmail, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="email@example.com"
                                 Margin="0,8,8,4" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Password:" VerticalAlignment="Center"
                                   Margin="0,4,0,0" />
                        <PasswordBox Grid.Row="2" Grid.Column="1"
                                     x:Name="BackendPasswordBox"
                                     Margin="0,4,8,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:Button Appearance="Primary"
                                   Content="Login / Register"
                                   Command="{Binding LoginBackendCommand}"
                                   CommandParameter="{Binding ElementName=BackendPasswordBox}" />
                        <ui:Button Appearance="Subtle"
                                   Content="Disconnect"
                                   Command="{Binding DisconnectBackendCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding BackendStatus}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="AI Providers"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <ItemsControl ItemsSource="{Binding AiProviders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6"
                                        CornerRadius="4"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                 ui:TextBoxHelper.PasswordRevealMode="Visible"
                                                 PlaceholderText="Enter API Key..." />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Local Models"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Model Path:"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding LocalModelPath, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="C:\Models\..."
                                 Margin="0,0,8,0" />
                        <ui:Button Grid.Column="2"
                                   Appearance="Subtle"
                                   Icon="FolderOpen24"
                                   Command="{Binding BrowseLocalModelPathCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Database"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Database:" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding DatabaseInfo}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Size:" VerticalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding DatabaseSize}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Plugins"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <Button Content="Open Plugin Settings"
                            Command="{Binding OpenPluginSettingsCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Updates &amp; Maintenance"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Current Version: 1.0.0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding UpdateStatus}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       FontSize="12" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Appearance="Primary"
                                   Content="Check for Updates"
                                   Command="{Binding CheckForUpdatesCommand}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Backup &amp; Restore"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ui:Button Appearance="Primary"
                                   Icon="Backup24"
                                   Content="Backup"
                                   Command="{Binding BackupCommand}" />
                        <ui:Button Appearance="Subtle"
                                   Icon="Restore24"
                                   Content="Restore"
                                   Command="{Binding RestoreCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,0,0,24" />
        </StackPanel>
    </ScrollViewer>
</ui:UiPage>
