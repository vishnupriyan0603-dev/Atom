<ui:UiPage x:Class="AtomAssistant.Views.Pages.FilesPage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
            xmlns:local="clr-namespace:AtomAssistant.Views.Pages"
            mc:Ignorable="d"
            d:DesignHeight="800" d:DesignWidth="1200"
            Title="Files">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="File Analysis"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,0,0,16" />

        <Border Grid.Row="1"
                CornerRadius="8"
                BorderThickness="2"
                BorderBrush="{DynamicResource CardBorderBrush}"
                Background="{DynamicResource CardBackgroundBrush}"
                Padding="32"
                AllowDrop="True"
                DragEnter="DropZone_DragEnter"
                Drop="DropZone_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <ui:SymbolIcon Symbol="CloudUpload24"
                                   FontSize="48"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="center" />
                    <TextBlock Text="Drag &amp; Drop files here"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="or click to browse"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,4" CornerRadius="4" Margin="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="{Binding FileType, Converter={StaticResource FileTypeToIconConverter}}"
                                                   FontSize="24"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FilePath}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FileSize, StringFormat='{0:N0} KB'}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="8,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,16,0,0">
                    <ui:Button Appearance="Primary"
                               Icon="CodeAnalyzer24"
                               Content="Analyze"
                               Command="{Binding AnalyzeCommand}" />
                    <ui:Button Appearance="Subtle"
                               Icon="Summarize24"
                               Content="Summarize"
                               Command="{Binding SummarizeCommand}" />
                    <ui:Button Appearance="Subtle"
                               Icon="Chat24"
                               Content="Chat with File"
                               Command="{Binding ChatWithFileCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Margin="0,8,0,0" />
    </Grid>
</ui:UiPage>
