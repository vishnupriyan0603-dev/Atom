<ui:UiPage x:Class="AtomAssistant.Views.Pages.DashboardPage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
            xmlns:local="clr-namespace:AtomAssistant.Views.Pages"
            mc:Ignorable="d"
            d:DesignHeight="800" d:DesignWidth="1200"
            Title="Dashboard">

    <ScrollViewer>
        <StackPanel Margin="32" Spacing="24">

            <TextBlock Text="Welcome to AtomAssistant"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <TextBlock Text="Your AI-powered development companion"
                       FontSize="16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,-12,0,0" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Recent Chats"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding RecentChats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding RecentChatsCount, StringFormat='Total: {0}'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasRecentChats, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="No recent chats"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasNoRecentChats, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="1" Margin="4,0" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Recent Files"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding RecentFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding RecentFilesCount, StringFormat='Total: {0}'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="No recent files"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasNoRecentFiles, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="2" Margin="8,0,0,0" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Favorite Prompts"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding FavoritePrompts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding FavoritePromptsCount, StringFormat='Total: {0}'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasFavoritePrompts, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="No favorite prompts"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasNoFavoritePrompts, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="System Status"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="GPU:" Margin="0,0,12,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ProgressBar Grid.Row="0" Grid.Column="1"
                                         Value="{Binding GpuUsage}"
                                         Maximum="100"
                                         Height="16"
                                         Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="{Binding GpuUsageText}"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="CPU:" Margin="0,0,12,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ProgressBar Grid.Row="1" Grid.Column="1"
                                         Value="{Binding CpuUsage}"
                                         Maximum="100"
                                         Height="16"
                                         Margin="0,0,8,4" />
                            <TextBlock Grid.Row="1" Grid.Column="2"
                                       Text="{Binding CpuUsageText}"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="RAM:" Margin="0,0,12,4"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ProgressBar Grid.Row="2" Grid.Column="1"
                                         Value="{Binding RamUsage}"
                                         Maximum="100"
                                         Height="16"
                                         Margin="0,0,8,4" />
                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       Text="{Binding RamUsageText}"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding SystemUptime, StringFormat='Uptime: {0}'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="1" Margin="8,0,0,0" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Storage"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding StorageUsed, StringFormat='Used: {0}'}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding StorageFree, StringFormat='Free: {0}'}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ProgressBar Value="{Binding StorageUsagePercent}"
                                     Maximum="100"
                                     Height="20" />
                        <TextBlock Text="{Binding InstalledModelsCount, StringFormat='Installed Models: {0}'}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ui:Card>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</ui:UiPage>
