<ui:UiPage x:Class="AtomAssistant.Views.Pages.HistoryPage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
            xmlns:local="clr-namespace:AtomAssistant.Views.Pages"
            mc:Ignorable="d"
            d:DesignHeight="800" d:DesignWidth="1200"
            Title="History">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Chat History"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,0,0,16" />

        <TextBox Grid.Row="1"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="Search chat history..."
                 Margin="0,0,0,12" />

        <Border Grid.Row="2"
                CornerRadius="6"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1">
            <ListView ItemsSource="{Binding GroupedChats}"
                      SelectedItem="{Binding SelectedChat}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="12,8,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8" CornerRadius="4" Margin="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Preview}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="32" />
                                    <TextBlock Text="{Binding LastModified, StringFormat='{0:MMM dd, yyyy h:mm tt}'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <ui:Button Grid.Column="1"
                                           Appearance="Subtle"
                                           Icon="Archive24"
                                           ToolTip="Archive"
                                           Command="{Binding DataContext.ArchiveChatCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                           CommandParameter="{Binding}"
                                           Margin="4,0" />

                                <ui:Button Grid.Column="2"
                                           Appearance="Subtle"
                                           Icon="Delete24"
                                           ToolTip="Delete"
                                           Command="{Binding DataContext.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                           CommandParameter="{Binding}"
                                           Margin="4,0" />

                                <ui:Button Grid.Column="3"
                                           Appearance="Subtle"
                                           Icon="Restore24"
                                           ToolTip="Restore"
                                           Command="{Binding DataContext.RestoreChatCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                           CommandParameter="{Binding}"
                                           Visibility="{Binding IsArchived, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Margin="4,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</ui:UiPage>
